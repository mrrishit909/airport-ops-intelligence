 "components": {
  "schemas": {
   "DisruptionIn": {
    "properties": {
     "type": {
      "type": "string",
      "const": "thunderstorm",
      "title": "Type"
     },
     "severity": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Severity"
     },
     "starts_at": {
      "type": "string",
      "format": "date-time",
      "title": "Starts At"
     },
     "ends_at": {
      "type": "string",
      "format": "date-time",
      "title": "Ends At",
      "description": "When the forecast says it ends"
     },
     "arrival_rate_per_hour": {
      "type": "integer",
      "maximum": 46.0,
      "minimum": 5.0,
      "title": "Arrival Rate Per Hour",
      "description": "Landings an hour while it lasts"
     },
     "departure_rate_per_hour": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 5.0,
      "title": "Departure Rate Per Hour",
      "description": "Pushbacks an hour while it lasts"
     }
    },
    "type": "object",
    "required": [
     "type",
     "severity",
     "starts_at",
     "ends_at",
     "arrival_rate_per_hour",
     "departure_rate_per_hour"
    ],
    "title": "DisruptionIn"
   },
   "FlightUpdate": {
    "properties": {
     "flight_no": {
      "type": "string",
      "pattern": "^[A-Z]{2}\\d{3,4}$",
      "title": "Flight No"
     },
     "observed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Observed At"
     },
     "origin_delay_min": {
      "type": "number",
      "maximum": 600.0,
      "minimum": -30.0,
      "title": "Origin Delay Min",
      "description": "Minutes late (negative: early) the aircraft left its origin, or the delay the origin has now posted"
     }
    },
    "type": "object",
    "required": [
     "flight_no",
     "observed_at",
     "origin_delay_min"
    ],
    "title": "FlightUpdate"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "description": "Which synthetic airport to generate",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "Lock": {
    "properties": {
     "flight_no": {
      "type": "string",
      "pattern": "^[A-Z]{2}\\d{3,4}$",
      "title": "Flight No"
     },
     "gate": {
      "type": "string",
      "pattern": "^[AB]\\d{1,2}$",
      "title": "Gate"
     }
    },
    "type": "object",
    "required": [
     "flight_no",
     "gate"
    ],
    "title": "Lock"
   },
   "OptimiseIn": {
    "properties": {
     "locks": {
      "items": {
       "$ref": "#/components/schemas/Lock"
      },
      "type": "array",
      "maxItems": 20,
      "title": "Locks",
      "description": "Flights that must use a given gate",
      "default": []
     },
     "hold_minutes": {
      "type": "integer",
      "maximum": 20.0,
      "minimum": 0.0,
      "title": "Hold Minutes",
      "description": "Longest a departure may be held for connecting passengers; 0 turns holding off",
      "default": 15
     },
     "futures": {
      "type": "integer",
      "maximum": 12.0,
      "minimum": 2.0,
      "title": "Futures",
      "description": "How many sampled versions of the rest of the day the plan is judged on",
      "default": 6
     },
     "tries": {
      "type": "integer",
      "maximum": 3000.0,
      "minimum": 50.0,
      "title": "Tries",
      "default": 800
     }
    },
    "type": "object",
    "title": "OptimiseIn"
   },
   "ScenarioIn": {
    "properties": {
     "plan_ids": {
      "items": {
       "type": "string",
       "format": "uuid"
      },
      "type": "array",
      "maxItems": 5,
      "title": "Plan Ids",
      "default": []
     }
    },
    "type": "object",
    "title": "ScenarioIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}