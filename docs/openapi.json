  "/v1/airports/{airport_id}/operations": {
   "get": {
    "tags": [
     "airport"
    ],
    "summary": "The airport now and for the next hours: each flight's estimate and gate, who is expected to wait for a gate, connections at risk",
    "operationId": "operations_v1_airports__airport_id__operations_get",
    "parameters": [
     {
      "name": "airport_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid",
       "title": "Airport Id"
      }
     },
     {
      "name": "window",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^([1-9]|1[0-2])h$",
       "default": "6h",
       "title": "Window"
      }
     },
     {
      "name": "authorization",
      "in": "header",
